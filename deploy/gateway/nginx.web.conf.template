# Web-only gateway: runs on the frontend EC2 instances (site host).
# API traffic never reaches these boxes — the ALB routes /api/* and the API
# hostname to the backend target group.
limit_req_zone $binary_remote_addr zone=general:10m rate=20r/s;
limit_conn_zone $binary_remote_addr zone=perip:10m;

server {
  listen 8080;
  server_tokens off;
  client_max_body_size 1m;
  client_body_timeout 10s;
  client_header_timeout 10s;
  limit_conn perip 50;

  add_header X-Content-Type-Options "nosniff" always;
  add_header X-Frame-Options "DENY" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;
  add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

  # Static site: only safe methods make sense here
  if ($request_method !~ ^(GET|HEAD|OPTIONS)$) {
    return 405;
  }

  # Origin secret required for everything except the ALB health check
  set $block_origin 1;
  set $skip_check "${SKIP_ORIGIN_CHECK}";
  if ($skip_check = "1") {
    set $block_origin 0;
  }
  if ($http_x_origin_verify = "${ORIGIN_HEADER_VALUE}") {
    set $block_origin 0;
  }
  if ($http_x_origin_verify = "${ORIGIN_HEADER_VALUE_PREV}") {
    set $block_origin 0;
  }
  if ($request_uri = "/healthz") {
    set $block_origin 0;
  }
  if ($block_origin = 1) {
    return 403;
  }

  # ALB health check for the web target group
  location = /healthz {
    access_log off;
    default_type application/json;
    return 200 '{"ok":true,"service":"gateway-web"}';
  }

  location / {
    limit_req zone=general burst=40 nodelay;
    proxy_pass http://web:8080/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 5s;
    proxy_read_timeout 15s;
  }
}
