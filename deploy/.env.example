APP_ENV=dev
APP_NAME=template
ORIGIN_HEADER_VALUE=local-dev-secret
SKIP_ORIGIN_CHECK=1
ALLOWED_ORIGINS=

# Local Postgres: COMPOSE_PROFILES=local docker compose up --build
COMPOSE_PROFILES=local
DATABASE_URL=postgres://app:localdev@db:5432/app
DATABASE_SSL=0

COGNITO_REGION=eu-west-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_DOMAIN=
VITE_COGNITO_REGION=eu-west-1
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_DOMAIN=
BOOTSTRAP_ADMIN_EMAILS=
