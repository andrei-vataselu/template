APP_ENV=dev
APP_NAME=template
ORIGIN_HEADER_VALUE=local-dev-secret
# Optional previous value for dual-period rotation testing (defaults to current locally)
ORIGIN_HEADER_VALUE_PREV=local-dev-secret
# Local only — AWS user_data forces 0. Default in compose is also 0.
SKIP_ORIGIN_CHECK=1
ALLOWED_ORIGINS=
INVITE_ONLY=0

# Role selection:
#   local (everything):  COMPOSE_PROFILES=local,api,web  GATEWAY_MODE=all
#   backend instance:    COMPOSE_PROFILES=api            GATEWAY_MODE=api
#   frontend instance:   COMPOSE_PROFILES=web            GATEWAY_MODE=web
COMPOSE_PROFILES=local,api,web
GATEWAY_MODE=all

DATABASE_URL=postgres://app:localdev@db:5432/app
DATABASE_SSL=0
# 1 = verify the RDS CA chain (requires NODE_EXTRA_CA_CERTS below)
DATABASE_SSL_STRICT=0
NODE_EXTRA_CA_CERTS=
# CloudFront -> ALB -> gateway = 3 hops on AWS; 1 for plain local gateway
TRUST_PROXY_HOPS=1

COGNITO_REGION=eu-west-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_DOMAIN=
VITE_COGNITO_REGION=eu-west-1
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_DOMAIN=
# Absolute API base URL baked into the frontend build (empty = same origin /api)
VITE_API_BASE_URL=
# 1 = hide Sign up CTAs (invite-only). Baked at Vite build time.
VITE_INVITE_ONLY=0
BOOTSTRAP_ADMIN_EMAILS=
