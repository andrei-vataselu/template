# COST: expected ~$28–30/mo (see infra/COST_GATE.txt). Alert at 25 will fire.
aws_region               = "eu-west-1"
project_name             = "popo"
application_name         = "template"
environment              = "dev"
cost_center              = "cc-dev-sandbox"
alert_email              = "REPLACE_ME@example.com"
monthly_budget_usd       = 25
instance_type            = "t4g.micro"
db_instance_class        = "db.t4g.micro"
root_volume_gb           = 30
db_storage_gb            = 20
backup_retention_days    = 3
db_multi_az              = false
db_deletion_protection   = false
db_skip_final_snapshot   = true
vpc_cidr                 = "10.20.0.0/16"
app_git_url              = ""
# Lock dev to your IP(s). Get yours: curl https://checkip.amazonaws.com
# [] = open to everyone.
allowed_ip_cidrs         = ["YOUR_IP/32"]
