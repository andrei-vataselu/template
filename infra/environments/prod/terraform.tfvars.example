# PROD — same security/network architecture as DEV; only tiers differ.
# Expected ~$88+/mo with Pro + Multi-AZ small DB (see infra/COST_GATE.txt).
# Business private VPC origin (~$245+) is NOT enabled in this repo.
aws_region               = "eu-west-1"
project_name             = "popo"
application_name         = "template"
environment              = "prod"
cost_center              = "cc-prod-core"
alert_email              = "REPLACE_ME@example.com"
monthly_budget_usd       = 100
instance_type            = "t4g.small"
db_instance_class        = "db.t4g.small"
root_volume_gb           = 40
db_storage_gb            = 40
backup_retention_days    = 14
db_multi_az              = true
db_deletion_protection   = true
db_skip_final_snapshot   = false
vpc_cidr                 = "10.30.0.0/16"
app_git_url              = ""
# Prod is public by default. During a private beta you can lock it to
# specific IPs the same way as dev:
# allowed_ip_cidrs       = ["YOUR_IP/32"]
allowed_ip_cidrs         = []
