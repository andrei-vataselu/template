COGNITO_REGION=eu-west-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# Postgres — unset = in-memory directory (single process only)
DATABASE_URL=postgres://app:localdev@127.0.0.1:5432/app
DATABASE_SSL=0

# Bootstrap admin by Cognito email (matched at login, never stored) and/or sub
BOOTSTRAP_ADMIN_EMAILS=
BOOTSTRAP_ADMIN_SUBS=

PORT=3000
APP_ENV=dev
APP_NAME=template
ALLOWED_ORIGINS=
