# Public Cognito SPA settings (baked in at Vite build time)
VITE_COGNITO_REGION=eu-west-1
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
# Hosted UI domain prefix from terraform module output `hosted_ui_domain`
VITE_COGNITO_DOMAIN=
# Absolute API base URL (e.g. https://api-dev.example.com) when the backend is
# hosted on its own domain. Empty = same-origin /api (local dev proxy).
VITE_API_BASE_URL=
# Set to 1 to hide Sign up CTAs (invite-only). Baked at Vite build time.
VITE_INVITE_ONLY=0
